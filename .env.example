# ============ ROADIE env ============
ROADIE_PORT=3001

# --- mymymy catalog backend ---
# Local dev: http://localhost:8000   |   Live (tunnel): https://app.mymymy.studio
# In Docker (same stack): http://mymymy-api:8000
MYMYMY_API_URL=https://app.mymymy.studio
MYMYMY_SERVICE_TOKEN=

# --- Ask ROADIE brain (optional; deterministic offline brain used if unset) ---
# Preference order: Gemini -> Anthropic -> offline
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Voice (talk-back) ---
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon

# ============ Google (uses the "mymymy" Google Cloud project) ============
# Maps JavaScript API key (enable Maps JavaScript API in the mymymy project,
# restrict the key to roadie.mymymy.studio + localhost). This one is public/client-side.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gmail + Drive via OAuth2. CLIENT_ID/SECRET come from the mymymy OAuth client
# (already present if you copied mymymy's .env). Generate a REFRESH_TOKEN once with
# Gmail + Drive scopes (e.g. via the OAuth Playground), then paste it here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_SEND_FROM=
GOOGLE_DRIVE_FOLDER_ID=

# --- Deploy (Cloudflare tunnel on the mymymy domain) ---
CLOUDFLARED_TOKEN=

# --- Private bundle download (optional self-distribution) ---
# Stage a zip at ROADIE_DIST_PATH on the server, set a token, then share:
#   https://roadie.mymymy.studio/api/grab?key=<ROADIE_DOWNLOAD_TOKEN>
ROADIE_DOWNLOAD_TOKEN=
ROADIE_DIST_PATH=

# --- Currency + membership ---
# Indicative FX (USD per 1 CAD) for the CAD/USD display switch. Charge currency is USD via mymymy.
NEXT_PUBLIC_USD_PER_CAD=0.73
# Where ROADIE sends users for subscription checkout (mymymy owns billing)
MYMYMY_PUBLIC_URL=https://app.mymymy.studio

# --- Same-world accounts / SSO bridge ---
# Share the session cookie across *.mymymy.studio so both apps see the login.
COOKIE_DOMAIN=.mymymy.studio
# Shared secret for the signed SSO token (set the SAME value in mymymy's .env).
SSO_SECRET=
